# NOVA – Umgebungsvariablen (Vorlage). Echte Werte nur in .env.local bzw. in Vercel hinterlegen.

# Supabase (nur serverseitig genutzt – bewusst ohne NEXT_PUBLIC_-Präfix)
SUPABASE_URL=https://<projekt-ref>.supabase.co
# Publishable Key (oder Legacy Anon Key). Durch Row Level Security abgesichert.
SUPABASE_PUBLISHABLE_KEY=

# Öffentliche Basis-URL der App (für Einladungslinks). Lokal: http://localhost:3100
APP_URL=https://nova.example.de

# Demo-Website mit synthetischen Daten. In Produktion standardmäßig aus.
ANALYTICS_DEMO_ENABLED=false
