{
  "name": "nova-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:types": "supabase gen types typescript --local --schema analytics,core,public > src/lib/supabase/database.types.ts",
    "db:test": "supabase test db",
    "build:tracker": "node tracker/build.mjs",
    "prebuild": "node tracker/build.mjs",
    "predev": "node tracker/build.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.2"
  }
}
